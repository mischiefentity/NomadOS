#!/usr/bin/env bash
set -euo pipefail

LIVE_USER="nomad"
LIVE_HOME="/home/$LIVE_USER"

if ! id "$LIVE_USER" >/dev/null 2>&1; then
    useradd \
        --create-home \
        --groups wheel,audio,video,storage,optical \
        --shell /usr/bin/zsh \
        "$LIVE_USER"
fi

echo "${LIVE_USER}:nomad" | chpasswd

# Passwordless sudo applies only to the disposable live environment.
install -Dm440 /dev/stdin /etc/sudoers.d/10-nomados-live <<'SUDOEOF'
%wheel ALL=(ALL:ALL) NOPASSWD: ALL
SUDOEOF

chown -R "$LIVE_USER:$LIVE_USER" "$LIVE_HOME"

touch /var/lib/nomados-live-setup-complete
